# Daily Rehearsal backend local environment example.
# Copy this file to .env.local or export these values in your shell.
# Do not put real secrets in this file.

# AI provider routing
REHEARSAL_AI_DEFAULT_PROVIDER=none
SLOT_EXTRACTION_AI_PROVIDER=fake
SLOT_EXTRACTION_AI_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_MAX_OUTPUT_TOKENS=512
OPENAI_TEMPERATURE=0.0
OPENAI_STORE=false

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.0
GEMINI_THINKING_BUDGET=0
