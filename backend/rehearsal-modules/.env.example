# Daily Rehearsal backend local environment example.
# Copy this file to .env.local or export these values in your shell.
# Do not put real secrets in this file.

# AI provider
REHEARSAL_AI_DEFAULT_PROVIDER=none

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.0
GEMINI_THINKING_BUDGET=0
