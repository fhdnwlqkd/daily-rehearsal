# Daily Rehearsal backend local environment example.
# Copy this file to .env.local or export these values in your shell.
# Do not put real secrets in this file.

# AI provider (gemini | fake)
REHEARSAL_AI_DEFAULT_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.0
GEMINI_THINKING_BUDGET=0

# Frontend base URL used to generate mobile ticket download QR links.
TICKET_DOWNLOAD_PAGE_BASE_URL=http://localhost:3000
