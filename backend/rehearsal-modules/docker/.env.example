# EC2 배포 서버의 /opt/daily-rehearsal/.env 로 복사해서 값을 채운다.
# 이 파일 자체는 git에 올리는 템플릿이고, 실제 값이 채워진 .env는 git에 올리지 않는다.

# 백엔드 API 호출 인증 키 (X-API-KEY 헤더로 검증, 없으면 모든 /api/** 요청이 401)
API_KEY=

# MySQL root 비밀번호 (compose 변수 치환 + app datasource 양쪽에 쓰임)
DB_PASSWORD=

# MySQL 데이터베이스 이름
DB_NAME=rehearsal

# Gemini API 키 (없으면 앱이 기동 실패함)
GEMINI_API_KEY=

# Decart WebRTC API 키 (기능을 쓸 때만 필요)
DECART_API_KEY=

# 영상 다운로드 URL의 공개 base URL (기본값은 localhost라 운영에서는 EC2 퍼블릭 IP/도메인으로 교체)
VIDEO_STORAGE_PUBLIC_BASE_URL=

# Mobile frontend base URL encoded into ticket QR codes.
TICKET_DOWNLOAD_PAGE_BASE_URL=http://32.236.96.32:3000

# ECR 이미지 경로. 예: 123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/daily-rehearsal-backend
ECR_IMAGE=

# 배포할 이미지 태그. 최초 수동 기동 때는 latest, 이후엔 배포 파이프라인이 커밋 SHA로 덮어씀
IMAGE_TAG=latest
