# 실제 값은 .env.local(gitignore됨)에 넣는다. 이 파일에는 변수 이름만 남긴다.
# ⚠️ 아래 변수들은 서버 전용 시크릿 — NEXT_PUBLIC_ 접두사를 붙이면
# 브라우저 번들에 노출되므로 절대 붙이지 말 것. (프록시 라우트만 읽는다)

# 백엔드 실서버 주소 (IP·포트는 시크릿 — 팀 내부에서 공유받는다)
API_BASE_URL=

# 백엔드 인증 키 (프록시가 x-api-key 헤더로 첨부)
API_KEY=

# Decart 사용 여부. false면 프론트 프록시가 토큰 발급 요청을 차단해 과금하지 않는다.
# 미설정 또는 true면 기존처럼 Decart를 사용한다. 변경 후 프론트 서버를 재시작한다.
DECART_ENABLED=true
